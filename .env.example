# ===== Firebase config (โหมด cloud sync) =====
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจาก Firebase console → Project settings → Web app
# ดูวิธีทีละขั้นตอนใน SETUP.md
# ถ้าปล่อยว่างทั้งหมด → แอพทำงานโหมด localStorage (ข้อมูลอยู่ในเครื่อง ไม่ sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ใช้ Firebase Emulator ในเครื่อง (สำหรับนักพัฒนาเท่านั้น)
# VITE_FIREBASE_EMULATOR=1

# base path ของเว็บ (GitHub Pages ใช้ /Wellgateit/ — ตั้งใน workflow อัตโนมัติ)
# VITE_BASE=/
